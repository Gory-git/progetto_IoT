            <%trans("admin.psswd_pass");%>
            :</td>
          <td width="50%"><font size=2>
            <input type="password" name="newpass" size="20" maxlength="30"></td>
        </tr>
  		<tr height="20"><td></td></tr>
      <tr>
          <td width="50%"><font size=2>
            <%trans("admin.pass_conf");%>
            :</td>
          <td width="50%"><font size=2>
            <input type="password" name="confpass" size="20" maxlength="30"></td>
        </tr>
      </table>
      <input type="hidden" value="/home.htm" name="submit-url">
	  <br />	  <br />	  <br />
      <table width="100%">
        <tr>
          <td class="submitFooter" width="100%"><script type="text/javascript">
   document.write('<input type="submit" class="submit1 accentColor" value="'+share.apply+'" name="save"  onClick="return saveChanges()">');
	document.write('&nbsp;&nbsp;')
   document.write('<input type="reset" class="submit1 accentColor" value="'+share.reset+'" name="reset">');
  
	</script></td>
        </tr>
      </table>
    </form>
	<table height="20px">
	</table>	
  </div>
