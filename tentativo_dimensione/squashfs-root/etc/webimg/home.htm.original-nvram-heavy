/*  

	$("#apply").click(function(){
		if (CheckValue())
		{
			homesubmit = setTimeout(TimeOut, 10000);
			$("#idFSetup").ajaxSubmit(options);
			return false;
		}
	});
*/
 
});
function dw(str){document.write(str)}
function Capture(obj){if (obj!=""&& obj!=undefined)dw(obj)}
function dw_main_wzd(url,str){dw('<a href="'+url+'" title="'+str+'"><div style="width:100%; height:100%">'+str+'</div></a>')}function get_by_id(id){with(document){return getElementById(id)}}
function checkHex(str){var len=str.length;for(var i=0;i<len;i++){if((str.charAt(i)>='0'&&str.charAt(i)<='9')||(str.charAt(i)>='a'&&str.charAt(i)<='f')||(str.charAt(i)>='A'&&str.charAt(i)<='F')){continue}else return false};return true};function checkStr(str){var len=str.length;for(var i=0;i<len;i++){if((str.charAt(i)>='0'&&str.charAt(i)<='9')||(str.charAt(i)>='a'&&str.charAt(i)<='z')||(str.charAt(i)>='A'&&str.charAt(i)<='Z')){continue}else return false};return true}
function showResponse(responseText, statusText, xhr, $form)
{
	if (statusText == "success")
	{
		clearTimeout(homesubmit);
		if (responseText == 'setok')
		{
			
		}
		else
		{
		}
	}
}
 

function check_wepkey(val)
{
	if (val.value.length==5||val.value.length==13 && checkStr(val.value)==true)
	{
		if (val.value.length==5)
			$("#weplength").val("1");
		else
			$("#weplength").val("2");
		$("#wepformat").val("1");
		return true;
	}
	else if ((val.value.length==10||val.value.length==26) && checkHex(val.value)==true)
	{
		if (val.value.length==10)
			$("#weplength").val("1");
		else
			$("#weplength").val("2");
		$("#wepformat").val("2");
		return true;
	}
	return false;
}
function check_wpa_psk(val)
{
	str = val.value;
	if (str.length==64)
	{
		for (var i=0; i<str.length; i++) 
		{
			if ( (str.charAt(i) >= '0' && str.charAt(i) <= '9') ||
			(str.charAt(i) >= 'a' && str.charAt(i) <= 'f') ||
			(str.charAt(i) >= 'A' && str.charAt(i) <= 'F') )
				continue;
			alert(wlan.se_alert18);
			val.value = "";
			val.focus();
			return false;
		}
		get_by_id("wl_pskFormat").value = "1";
		return true;
	}
	if (str.length < 8||str.length > 63) 
	{
		val.value = "";
		alert(wlan.se_alert18);
		return false;
	}
/*	for (var i=0; i<str.length; i++) 
	{
		if ( (str.charAt(i) >= '0' && str.charAt(i) <= '9') ||
		(str.charAt(i) >= 'a' && str.charAt(i) <= 'z') ||
		(str.charAt(i) >= 'A' && str.charAt(i) <= 'Z') )
			continue;

		alert(wlan.se_alert18);
		val.value = "";
		val.focus();
		return false;
	}
*/
	get_by_id("wl_pskFormat").value = "0";
	return true;
}

function CheckValue()
{

	if ($("#wl_ssid_t").val() == "")
	{
		alert(wlan.ssid_msg);
		$("#wl_ssid").focus();
		return false;
	}
	$("#wl_ssid").val($("#wl_ssid_t").val());
	
	var wl_Method = $("#wl_Method_t").val();
	if (wl_Method==0)
	{}
	else if (wl_Method == 1)
	{
		if (check_wepkey(get_by_id("web_pskValue")) != true)
		{
			$("#web_pskValue").val('');
			$("#web_pskValue").focus();
			alert(wlan.se_alert17);
			return false;
		}
		$("#wl_pskValue").val($("#web_pskValue").val());
	}
	else if (wl_Method==2||wl_Method==4||wl_Method==6)
	{
		if (check_wpa_psk(get_by_id("web_pskValue"))!= true)
			return false;
	if (wl_Method==2||wl_Method==4)
		{
			$("#ciphersuite").val('aes');
			$("#wpa2ciphersuite").val('aes');
		}
		if (wl_Method==6)
		{
			$("#ciphersuite").val('tkip+aes');
			$("#wpa2ciphersuite").val('tkip+aes');
		}
		$("#wl_pskValue").val($("#web_pskValue").val());
	}
	$("#wl_Method").val($("#wl_Method_t").val());
	
	return true;
}

function selSecEasy()
{
	var wl_Method = $("#wl_Method_t")[0].selectedIndex;
	
	//$("#div_key").hide();
	disableTextField(get_by_id("web_pskValue"));
	if (wl_Method!=0)
	{
	enableTextField(get_by_id("web_pskValue"));
		$("#div_key").show();
		$("#web_pskValue").val("");
	}
}
function TimeOut()
{
	var showhtml = share.changeok+"\n\n";
	show_div(false,"loginimg");
	showhtml  += wlan.bs_ssid +": " + $("#wl_ssid_t").val() +"\n";
	//showhtml += wlan.wds_sec +": " + get_by_id("wl_Method").options[get_by_id("wl_Method_t").selectedIndex].innerText+"\n";
	if($("#wl_Method_t").val()!='0')
		showhtml +=share.key +": " + $("#web_pskValue").val() +"\n";
	if(isFromWL)
	alert(showhtml);
	this.location.reload();
}

function wlan_form()
{
	if((wsopmode==2||wsopmode==6)&(rep_EN==0))//Repeater or Wisp
	{
		alert(home.alert2)
		return false;
	}
	if(!CheckValue())
		return false;

	show_div(true,"loginimg");

	if(isFromWL==1)
	{
		jq_submit("home.htm", "wizap", true);
		return true;

	}

	document.nameFSetup.submit();
}

function initSec()
{
		if(wsopmode==0||wsopmode==1)//0:AP  1:Router  2:Repeater 6:Wisp
	{
		ssid = '<%getInfo("ssid");%>';
		mode = '<% getVirtualIndex("encrypt", "0") %>'*1;
		enable_1x = '<% getVirtualIndex("enable1X", "0") %>'*1;
		wlan_auth = '<% getVirtualIndex("authType", "0") %>'*1;
		wpa_auth = '<% getVirtualIndex("wpaAuth", "0") %>'*1;
		wapi_auth = '<% getVirtualIndex("wapiAuth", "0") %>'*1;
		wepmode = '<% getVirtualIndex("wep", "0") %>'*1;
		wep_key_fmt = '<% getVirtualIndex("keyType", "0") %>'*1;
		wpa_cipher = '<% getVirtualIndex("wpaCipher", "0") %>'*1;
		wpa2_cipher = '<% getVirtualIndex("wpa2Cipher", "0") %>'*1;
		psk_fmt = '<% getVirtualIndex("pskFormat", "0") %>'*1;
		key_val='<%getInfo("pskValue")%>'

	}
	else
	{
		ssid = '<%getInfo("repeaterSSID");%>';
		mode = '<% getVirtualIndex("encrypt", "5") %>'*1;
		enable_1x = '<% getVirtualIndex("enable1X", "5") %>'*1;
		wlan_auth = '<% getVirtualIndex("authType", "5") %>'*1;
		wpa_auth = '<% getVirtualIndex("wpaAuth", "5") %>'*1;
		wapi_auth = '<% getVirtualIndex("wapiAuth", "5") %>'*1;
		wepmode = '<% getVirtualIndex("wep", "5") %>'*1;
		wep_key_fmt = '<% getVirtualIndex("keyType", "5") %>'*1;
		wpa_cipher = '<% getVirtualIndex("wpaCipher", "5") %>'*1;
		wpa2_cipher = '<% getVirtualIndex("wpa2Cipher", "5") %>'*1;
		psk_fmt = '<% getVirtualIndex("pskFormat", "5") %>'*1;

	}
	$("#wl_ssid_t").val(ssid);

	if(wsopmode==0||wsopmode==1)//0:AP  1:Router  2:Repeater 6:Wisp
	{
		if (mode ==2|| mode ==4 ||mode ==6)
			def_pskValue = "<%getVirtualInfo("pskValue", 0);%>";
		else if (mode ==1)
			def_pskValue = "<%getVirtualInfo("wepkey", 0);%>";
	}
	else
	{
		if (mode ==2|| mode ==4 ||mode ==6)
			def_pskValue = "<%getVirtualInfo("pskValue", "5");%>";
		else if (mode ==1)
			def_pskValue = "<%getVirtualInfo("wepkey", "5");%>";
	}
	
	if(mode ==0)
		$("#wl_Method_t")[0].selectedIndex=0;
	else if(mode ==1)
		$("#wl_Method_t")[0].selectedIndex=1;
	else if(mode == 2)
		$("#wl_Method_t")[0].selectedIndex=2;
	else if (mode ==4)
		$("#wl_Method_t")[0].selectedIndex=3;
	else if (mode ==6)	
		$("#wl_Method_t")[0].selectedIndex=4;
	else 
		$("#wl_Method_t")[0].selectedIndex=0;
		
	selSecEasy();
	if (mode!=0)
		$("#web_pskValue").val(def_pskValue);
}
</script>
