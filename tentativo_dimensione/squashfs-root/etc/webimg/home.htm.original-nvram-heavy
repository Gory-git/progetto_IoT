			mssid_num=0;
		else
			mssid_num=<%getIndex("wlan_mssid_num");%>;
		dw('<tr ><td class="tb-title">'+share.md+'</td><td>');
		if(wlanMode[i] == 0)
			dw("AP");
		if (wlanMode[i] == 1) {
			if (networkType[0] == 0)
				dw(share.inclient);
			else
				dw(share.adclient);
		}
		if ( wlanMode[i] == 2 )
			dw( "WDS");
		if ( wlanMode[i] == 3 )
			dw( "AP+WDS");
		if( isNewMeshUI ==1 )
		{
			if ( wlanMode[i] == 4 )
				dw( "AP+MESH");  	
			if ( wlanMode[i] == 5 )
				dw( "MESH");
		}
		else
		{
			if ( wlanMode[i] == 4 )
				dw( "AP+MPP");  	
			if ( wlanMode[i] == 5 )
				dw( "MPP");
			if ( wlanMode[i] == 6 )
				dw( "MAP");	
			if ( wlanMode[i] == 7 )
				dw( "MP");  
		} 	
		dw('</td></tr>');
		dw('<tr ><td class="tb-title">'+wlan.bs_band+'</td><td>');
