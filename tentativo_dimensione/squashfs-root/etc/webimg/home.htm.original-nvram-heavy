   			dw( "2.4 GHz (G)");
    
    		if (band[i] == 8)
   		{
    			if(channel_drv[i] > 14)
    				dw( "5 GHz (N)");
    			else
   				dw( "2.4 GHz (N)");   		
   		}
   	
   		if (band[i] == 3)
   			dw( "2.4 GHz (B+G)");
    		if (band[i] == 4)
   			dw( "5 GHz (A)");
   		if (band[i] == 10)
   			dw( "2.4 GHz (G+N)");
   		if (band[i] == 11)
   			dw( "2.4 GHz (B+G+N)");		
   		if (band[i] == 12)
   			dw( "5 GHz (A+N)");
		if (band[i] == 15)
   			dw( "2.4GHz+5 GHz (A+B+G+N)");
		dw('</td></tr>');
		
		dw('<tr ><td class="tb-title">'+share.ssid+'</td><td>'+ssid_drv[i]+'</td></tr>');
		dw('<tr ><td class="tb-title">'+statu.chnum+'</td><td>'+channel_drv[i]+'</td></tr>');
		dw('<tr ><td class="tb-title">'+wlan.wds_sec+'</td><td>');
		if (wlanMode[i] == 0 || wlanMode[i] == 1)
    			dw(wep[i]);
		else if (wlanMode[i] == 2)
    			dw(wdsEncrypt[i]);
		else if (wlanMode[i] == 3)
    			dw(wep[i] + '(AP),  ' + wdsEncrypt[i] + '(WDS)');
		else if (wlanMode[i] == 4 || wlanMode[i] == 6)
    			dw(wep[i] + '(AP),  ' + meshEncrypt[i] + '(Mesh)');    	
    		else if (wlanMode[i] == 5|| wlanMode[i] == 7)
    			dw( meshEncrypt[i] + '(Mesh)');
		dw('</td></tr>');
		dw('<tr ><td class="tb-title">'+share.bssid+'</td><td>'+bssid_drv[i]+'</td></tr>');
		if (wlanMode[i]!=2) {
			if (wlanMode[i]==1)
				dw('<tr ><td class="tb-title">'+statu.state+'</td><td>'+state_drv[i]+'</td></tr>');
			else
				dw('<tr ><td class="tb-title">'+wlan.bs_assoccli+'</td><td>'+clientnum[i]+'</td></tr>');
	}
		dw('</table>');
		dw('</div>');
		
		// repeater
		if (rp_enabled[i])
		{
			dw('<div class="accentBorder" style=" margin-top:5px; border-width:3px; border-style:solid;">');
			dw(statu.reint)
			dw('<table class="accentColor" width="100%" border="0" cellspacing="0" cellpadding="0">');
			dw('<tr><td class="tb-title">'+share.md+'</td><td>');
			if(rp_mode[i] == 0)
				dw('AP');
			else
				dw('Infrastructure Client');
			dw('</td></tr>');
			dw('<tr >\
				<td width=40%><font size=2>'+share.ssid+'</td>\
				<td width=60%><font size=2>'+rp_ssid[i] +'</td>\
				</tr>\
				<tr >\
				<td width=40%><font size=2>'+wlan.wds_sec+'</td>\
				<td width=60%><font size=2>'+rp_encrypt[i] +'</td>\
				</tr>\
				<tr >\
				<td width=40%><font size=2>'+share.bssid+'</td>\
				<td width=60%><font size=2>'+rp_bssid[i] +'</td>\
				</tr>');
				var rep_wlanmode=<%getVirtualIndex("wlanMode","5");%>;
				var rep_clientnum=<%getVirtualInfo("clientnum","5");%>;
				var rep_state_drv='<%getInfo("repeaterState");%>';
				
				if(rep_wlanmode==1)
					dw('<tr ><td class="tb-title">'+statu.state+'</td>\
						<td>'+rep_state_drv+'</td>\
						</tr>');
				else
					dw('<tr ><td class="tb-title">'+wlan.bs_assoccli+'</td><td>'+rep_clientnum+'</td></tr>');

			dw('</table></div>');
		}
	}
			
