		if(ssid_drv[i]=="")
			mssid_num=0;
		else
			mssid_num=<%getIndex("wlan_mssid_num");%>;
   		

		
	
		document.write('<tr >\
		<td width=40%><font size=2>'+share.md+'</font></td>\
		<td width=60%><font size=2>' );
		/* mode */
		if(wlanMode[i] == 0)
			document.write("AP");
		if (wlanMode[i] == 1) {
			if (networkType[0] == 0)
				document.write( "Infrastructure Client");
			else
				document.write( "Ad-hoc Client");
		}
		if ( wlanMode[i] == 2 )
			document.write( "WDS");
		if ( wlanMode[i] == 3 )
			document.write( "AP+WDS");
		/*#ifdef CONFIG_NEW_MESH_UI*/
		if( isNewMeshUI ==1 )
		{
			if ( wlanMode[i] == 4 )
				document.write( "AP+MESH");  	
			if ( wlanMode[i] == 5 )
				document.write( "MESH");
		}
		else
		{
			if ( wlanMode[i] == 4 )
				document.write( "AP+MPP");  	
			if ( wlanMode[i] == 5 )
				document.write( "MPP");
			if ( wlanMode[i] == 6 )
				document.write( "MAP");	
			if ( wlanMode[i] == 7 )
				document.write( "MP");  
		} 	
		/* band */
		document.write('</td></tr>\
			<tr >\
	    		<td width=40%><font size=2>'+wlan.bs_band+'</font></td>\
	    		<td width=60%><font size=2>');
		if (band[i] == 1)
   			document.write( "2.4 GHz (B)");
    		if (band[i] == 2)
   			document.write( "2.4 GHz (G)");
    
    		if (band[i] == 8)
   		{
    			if(channel_drv[i] > 14)
    				document.write( "5 GHz (N)");
    			else
   				document.write( "2.4 GHz (N)");   		
   		}
   	
   		if (band[i] == 3)
   			document.write( "2.4 GHz (B+G)");
    		if (band[i] == 4)
   			document.write( "5 GHz (A)");
   		if (band[i] == 10)
   			document.write( "2.4 GHz (G+N)");
   		if (band[i] == 11)
   			document.write( "2.4 GHz (B+G+N)");		
   		if (band[i] == 12)
   			document.write( "5 GHz (A+N)");
		if (band[i] == 15)
   			document.write( "2.4GHz+5 GHz (A+B+G+N)");
		document.write('</font></td></tr>\
			<tr >\
    			<td width=40%><font size=2>SSID</font></td>\
    			<td width=60%><font size=2>');
		if (wlanMode[i] != 2) {
			document.write('<font size=2>');
			document.write(ssid_drv[i]);
		}
		//alert(ssid_drv[1]);
		//alert(wlanMode[i]);
		document.write('</td>\
			</tr>\
			<tr >\
			<td width=40%><font size=2>'+statu.chnum+'</td>\
			<td width=60%><font size=2>'+channel_drv[i] +'</td>\
			</tr>\
			<tr >\
			<td width=40%><font size=2>'+wlan.wds_sec+'</td>\
			<td width=60%><font size=2>');
			
		if (wlanMode[i] == 0 || wlanMode[i] == 1)
    			document.write(wep[i]);
		else if (wlanMode[i] == 2)
    			document.write(wdsEncrypt[i]);
		else if (wlanMode[i] == 3)
    			document.write(wep[i] + '(AP),  ' + wdsEncrypt[i] + '(WDS)');
		else if (wlanMode[i] == 4 || wlanMode[i] == 6)
    			document.write(wep[i] + '(AP),  ' + meshEncrypt[i] + '(Mesh)');    	
    		else if (wlanMode[i] == 5|| wlanMode[i] == 7)
    			document.write( meshEncrypt[i] + '(Mesh)');

		document.write('</td>\
  			</tr>\
  			<tr >\
    			<td width=40%><font size=2>BSSID</td>\
    			<td width=60%><font size=2>'+bssid_drv[i]+'</td>\
  			</tr>');
		if (wlanMode[i]!=2) {	//2 means WDS mode
			document.write('<tr >\n');
			if (wlanMode[i]==0 || wlanMode[i]==3 || wlanMode[i]==4) {
				document.write("<td width=40%%><font size=2>"+wlan.bs_assoccli+"</td>\n");
				document.write("<td width=60%%><font size=2>"+clientnum[i]+"</td></tr>");
			}
			else {
				document.write("<td width=40%%><font size=2>"+statu.state+"</td>\n");
				document.write('<td width=60%%><font size=2>'+state_drv[i]+'</td></tr>');
			}
 			
       	}
		document.write("</table></fieldset>")
		
		
		
		/* mesh does not support virtual ap */
		if (!wlanDisabled[i] && (wlanMode[i]==0 || wlanMode[i]==3 )) {
			for (idx=0; idx<mssid_num; idx++) {
				if (!mssid_disable[i][idx]) {
					document.write('<fieldset><legend>'+statu.vir+' AP'+(idx+1)+'Configuration</legend><table width="100%">\
						<tr >\
	    					<td width=40%><font size=2>'+wlan.bs_band+'</td>\
			    			<td width=60%><font size=2>');
					if (mssid_band[i][idx] == 1)
			   			document.write( "2.4 GHz (B)");
					else if (mssid_band[i][idx] == 2)
			   			document.write( "2.4 GHz (G)");
					else if (mssid_band[i][idx] == 8)
			   			document.write( "2.4 GHz (N)");  	
					else if (mssid_band[i][idx] == 3)
			   			document.write( "2.4 GHz (B+G)");
					else if (mssid_band[i][idx] == 4)
			   			document.write( "5 GHz (A)");
					else if (mssid_band[i][idx] == 10)
			   			document.write( "2.4 GHz (G+N)");
					else if (mssid_band[i][idx] == 11)
			   			document.write( "2.4 GHz (B+G+N)");		
					else if (mssid_band[i][idx] == 12)
						document.write( "5 GHz (A+N)");
	
					document.write('</td></tr>\
						<tr >\
			    			<td width=40%><font size=2>SSID</td>\
			    			<td width=60%><font size=2>');
					document.write('<pre><font size=2>'+mssid_ssid_drv[i][idx]+'</td>');

					document.write('</tr>\
						<tr >\
						<td width=40%><font size=2>'+wlan.wds_sec+'</td>\
						<td width=60%><font size=2>'+mssid_wep[i][idx]+'</td>');
			
					document.write('</tr>\
						<tr >\
						<td width=40%><font size=2>BSSID</td>\
						<td width=60%><font size=2>'+mssid_bssid_drv[i][idx]+'</td>');
				
					document.write('</tr>\
						<tr >\
						<td width=40%%><font size=2>'+wlan.bs_assoccli+'</td>\
						<td width=60%%><font size=2>'+mssid_clientnum[i][idx]+'</td></tr>');
						document.write('</table></fieldset>')
				}
			}
		}
		//    document.write('</table>\
		if (rp_enabled[i])	// start of repeater
		{
			document.write('<fieldset><legend>'+statu.reint+'</legend>\
			<table width="100%">')
				

			document.write('<tr >\
				<td width=40%><font size=2>'+share.md+'</td>\
				<td width=60%><font size=2>' );
			/* mode */
			if(rp_mode[i] == 0)
				document.write("AP");
			else
				document.write( "Infrastructure Client");
			document.write('</td>\
				</tr>\
				<tr >\
				<td width=40%><font size=2>SSID</td>\
				<td width=60%><font size=2>'+rp_ssid[i] +'</td>\
				</tr>\
				<tr >\
				<td width=40%><font size=2>'+wlan.wds_sec+'</td>\
				<td width=60%><font size=2>'+rp_encrypt[i] +'</td>\
				</tr>\
				<tr >\
				<td width=40%><font size=2>BSSID</td>\
				<td width=60%><font size=2>'+rp_bssid[i] +'</td>\
				</tr>');
			document.write('<tr >\n');
			if (rp_mode[i]==0 || rp_mode[i]==3) {
				document.write("<td width=40%><font size=2>"+wlan.bs_assoccli+"</td>\n");
				document.write("<td width=60%><font size=2>"+rp_clientnum[i]+"</td></tr>");
			}
			else {
				document.write("<td width=40%><font size=2>"+statu.state+"</td>\n");
				document.write('<td width=60%><font size=2>'+rp_state[i]+'</td></tr>');
			}
			document.write('</table></fieldset>')	// end of repeater
		}
	}//end of wlan_num for
</script>
