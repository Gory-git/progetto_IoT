   document.write('<input type="submit" class="submit1 accentColor " value="'+share.apply+'" name="save" onClick="return saveChanges()">')
	document.write("&nbsp;&nbsp;&nbsp;")
    document.write('<input type="reset" class="submit1 accentColor" value="'+share.reset+'" name="reset" onClick="resetClick()">')  
