<tr class="off">
      <td width="40%"><font size=2>
        
            <div align="justify">
              <%trans("inet.static_h2")%>
          :</div></td>
      <td width="60%">
				<script type="text/javascript">document.write('<input type="button" class="button1 accentColor" value="'+inet.lan_set_static+'" name="staticdhcpTbl" onClick="staticdhcpTblClick(\'/tcpip_staticdhcp.htm\')" >')</SCRIPT >      </td>
  </tr>

  <tr class="off">
      <td width="40%"><font size=2>
        
            <div align="justify">
              <%trans("share.domainname");%>
          :</div></td>
      <td width="60%"><input type="text" name="domainName" size="15" maxlength="30" value="<% getInfo("domainName"); %>"></td>
  </tr>

  <tr>
      <td width="40%"><font size=2>
        
            <div align="justify">
              <%trans("inet.lan_802")%>
          :</div></td>
      <td width="60%"><select size="1" name="stp">
     	  	<option value="0"><%trans("share.disable");%></option>
   	  		<option value="1"><%trans("share.enable");%></option>
	    </select>      </td>
  </tr>

  <tr class="off">
