<script type="text/javascript">
var isFromWL="<%getInfo("isWlanCon");%>";
var Request=new QueryString();
var showInfo=Request["showInfo"];
function QueryString(){
	var name,value,i;
	var str=location.href;
	var num=str.indexOf("?");
	if (num==-1)
	{
		return ;
	}
	str=str.substr(num+1);
	var arrtmp=str.split("&");
	for(i=0;i < arrtmp.length;i++){
		num=arrtmp[i].indexOf("=");
		if(num>0){
			name=arrtmp[i].substring(0,num);
			value=arrtmp[i].substr(num+1);
			this[name]=value;
		}
	}
}
function TimeOut()
{
	var showhtml = "";
	$("#id_div_all").slideUp("slow");
	$("#id_div_info").slideDown("slow");
	
	showhtml  += "<p>" + wlan.bs_ssid +":&nbsp;" + $("#ap_wSsid").val() +"</p>";
	showhtml += "<p>" + wlan.bs_chan +":&nbsp;" + ($("#wlanChan").val()=='0'?share.auto:$("#wlanChan").val()) +"</p>";
	//showhtml += "<p>" + wlan.wds_sec +":&nbsp;" + get_by_id("wlanMethod").options[get_by_id("wlanMethod").selectedIndex].innerText +"</p>";
	if($("#wlanMethod").val()!='0')
		showhtml += "<p>" + share.key +":&nbsp;" + $("#pskValue").val() +"</p>";
	showhtml +="<br /><br />"
	$("#id_p_info").html(showhtml);
}

function wlannext(id, F)
{
	{//ssid
		if (get_by_id("ap_wSsid").value=="")
		{
			alert(wlan.ssid_msg);
			get_by_id("ap_wSsid").focus();
			return;
		}
		wl_ssid = get_by_id("ap_wSsid").value;
		wl_method = get_by_id("wlanMethod").value;
	}
	wl_chan=get_by_id("wlanChan").value;
	
	//method & key
	if (wl_method==ws_w_wpa||wl_method==ws_w_wpa2||wl_method==ws_w_mix)
	{
		if(CheckWpaKey("pskValue")==false)
			return;
	}
	initApValue();
	hidethisbtn(id);
  	show_div(true,"errorinfo");
	
	if(0)//(isFromWL==1)
	{
		jq_submit("home.htm", "wizap", true);
		return false;

	}
	if(isFromWL==1)
	{
		get_by_id("go_web").value="hold"
	}
	TimeOut();
	submit(F, Def_Main_Page, "wzdap");

}
function init()
{
	if(showInfo==1)
		TimeOut();
}
</script>
